# Dollar In$ight - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# Database Configuration
# ============================================
# PostgreSQL (Main Database)
POSTGRES_USER=dollaruser
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=dollar_insight

# MongoDB (News & Document Storage)
MONGO_USER=admin
MONGO_PASSWORD=changeme_strong_password

# ============================================
# Redis Configuration
# ============================================
REDIS_PASSWORD=changeme_strong_password

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=changeme_generate_256bit_random_key_here

# ============================================
# Docker Registry
# ============================================
DOCKER_HUB_REPO=your-dockerhub-username

# ============================================
# LLM API Keys
# ============================================
# OpenAI API Key (for GPT models) - REQUIRED
OPENAI_API_KEY=sk-...

# Anthropic API Key (for Claude models) - OPTIONAL
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key - RECOMMENDED
GEMINI_API_KEY=...

# Additional LLM APIs (Optional)
# HUGGINGFACE_API_KEY=hf_...
# COHERE_API_KEY=...

# LLM Configuration
LLM_DEFAULT_MODEL=gpt-4o  # or claude-3.5-sonnet, gemini-pro
LLM_FALLBACK_MODEL=gemini-pro
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60

# ============================================
# External APIs (Optional)
# ============================================
# Alpha Vantage for stock data
ALPHA_VANTAGE_API_KEY=your_key_here

# News API for news crawling
NEWS_API_KEY=your_key_here

# ============================================
# Notification Webhooks (Optional)
# ============================================
# Slack webhook for CI/CD notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# ============================================
# SSL/TLS (Optional - for production)
# ============================================
# Domain name for SSL certificate
DOMAIN_NAME=your-domain.com
CERTBOT_EMAIL=your-email@example.com

# ============================================
# Application Settings
# ============================================
# Service environment
SERVICE_ENV=production

# Timezone
TZ=Asia/Seoul

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# Performance Tuning
# ============================================
# Java heap settings (Spring Boot)
JAVA_OPTS=-Xms512m -Xmx1024m

# MongoDB cache size (adjust based on available RAM)
MONGODB_CACHE_SIZE_GB=1

# ============================================
# Feature Flags (Optional)
# ============================================
ENABLE_MONITORING=false
ENABLE_PROMETHEUS=false
ENABLE_GRAFANA=false

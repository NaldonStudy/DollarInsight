# ==============================================
# Spring Boot Backend Configuration
# ==============================================

# Application
SPRING_PROFILES_ACTIVE=development
SERVER_PORT=8080

# Security
# JWT Settings 할 때 사용
# JWT_SECRET=change-this-to-super-secret-random-string-in-development
# JWT_EXPIRATION=86400000

# ==============================================
# Database Configuration (Docker 내부 통신)
# ==============================================

# PostgreSQL (Docker 네트워크 내부)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/dollar_insight
SPRING_DATASOURCE_USERNAME=your-postgres-username
SPRING_DATASOURCE_PASSWORD=b205dollarinsight
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA/Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# Redis (Docker 네트워크 내부)
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=b205dollarinsight

# MongoDB (Docker 네트워크 내부)
SPRING_DATA_MONGODB_HOST=mongodb
SPRING_DATA_MONGODB_PORT=27017
SPRING_DATA_MONGODB_DATABASE=dollar_insight
SPRING_DATA_MONGODB_USERNAME=admin
SPRING_DATA_MONGODB_PASSWORD=b205dollarinsight
SPRING_DATA_MONGODB_AUTHENTICATION_DATABASE=admin

# ==============================================
# gRPC Client (AI Service)
# ==============================================
# gPRC Client 설정 후 사용
# GRPC_CLIENT_AI_SERVICE_HOST=ai-service
# GRPC_CLIENT_AI_SERVICE_PORT=50051

# ==============================================
# Logging
# ==============================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_DOLLARINSIGHT=DEBUG
LOGGING_FILE_PATH=/app/logs